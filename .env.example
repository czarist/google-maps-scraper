#MYSQL BANCO NAO PERTURBE
MYSQL_BANCO_NAO_PERTURBE_HOST=localhost
MYSQL_BANCO_NAO_PERTURBE_PORT=3306
MYSQL_BANCO_NAO_PERTURBE_USER=root
MYSQL_BANCO_NAO_PERTURBE_PASS=
MYSQL_BANCO_NAO_PERTURBE_DB=root

# Page linked from every campaign email. ?servico=<campaign service> is added.
UNSUBSCRIBE_BASE_URL=https://trentin.software/descadastro

# ProxyScrape (https://docs.proxyscrape.com/api/account). When the key is set,
# new jobs use the proxies of your ProxyScrape plans by default.
# Test it at http://localhost:8081/proxyscrape/status or the "Test ProxyScrape API" button.
PROXYSCRAPE_API_KEY=
# http (default) or socks
PROXYSCRAPE_PROTOCOL=http
# Optional ISO country code to filter proxies, e.g. br
PROXYSCRAPE_COUNTRY=
# Residential plans only: gateway host:port shown in the ProxyScrape dashboard, e.g. rp.scrapegw.com:6060
PROXYSCRAPE_RESIDENTIAL_GATEWAY=

# Jobs that run at the same time (each one drives its own headless Chromium).
# 0 = half of the CPU threads (4 on an i7 with 8 threads).
WEB_JOB_WORKERS=0
